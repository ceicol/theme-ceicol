{
  "name": "theme-ceicol",
  "version": "0.31.0",
  "description": "Sistema de diseño de CEICOL para productos React + Material UI. Tokens de marca, tipografía, espaciado y variantes de componentes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceicol/theme-ceicol.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./semantic.css": "./dist/semantic.css",
    "./tokens.json": "./dist/tokens.json",
    "./tailwind": "./dist/tailwind.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/tokens.ts --format cjs,esm --dts --clean && node scripts/gen-tokens-css.mjs && node scripts/gen-dtcg.mjs && node scripts/gen-tailwind.mjs",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:mui-parity": "node scripts/check-mui-parity.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "ci": "npm run typecheck && npm run lint:css && npm run build && npm run check:tokens && npm run check:mui-parity && npm run check:theme",
    "release": "bash scripts/release.sh"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/material": ">=9",
    "react": ">=18"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^16.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
