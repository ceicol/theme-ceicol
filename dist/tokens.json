  "semantic": {
    "bg": {
      "$type": "color",
      "$value": "{color.background.default}",
      "$extensions": {
        "com.ceicol.theme": {
          "dark": "{color.surface.deep}"
        }
      }
    },
    "bg-raised": {
      "$type": "color",
